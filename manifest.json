{
  "manifest_version": 3,
  "name": "Prompt Ledger",
  "version": "2.0.0",
  "description": "A premium, minimal prompt manager \u2014 keep your day-to-day prompts sorted by client, ready to copy, download, or share.",
  "action": {
    "default_title": "Prompt Ledger"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "sidePanel"]
}
