{
  "manifest_version": 3,
  "name": "Prompt Ledger (Shared)",
  "version": "1.0.0",
  "description": "Opens your team's shared Prompt Ledger server in Chrome's side panel.",
  "action": {
    "default_title": "Prompt Ledger"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "sidePanel"]
}
